{
    "name": "lekoala/kaly",
    "description": "A small modular PSR HTTP framework with convention-based routing and first-class dependency injection",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Thomas",
            "email": "thomas@lekoala.be"
        }
    ],
    "keywords": [
        "framework",
        "http",
        "middleware",
        "psr-7",
        "psr-11",
        "psr-15",
        "router"
    ],
    "require": {
        "php": "^8.3",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "lekoala/kaly-di": "^0.3.2",
        "psr/clock": "^1.0",
        "psr/container": "^1.1.2|^2.0.2",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "symfony/polyfill-php84": "^1.30"
    },
    "require-dev": {
        "carthage-software/mago": "^1.50",
        "composer/ca-bundle": "^1.5",
        "latte/latte": "^3.0",
        "lekoala/kaly-tpl": "^0.2",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^12",
        "symfony/translation": "^7.1",
        "symfony/var-dumper": "^7.1",
        "twig/twig": "^3.0"
    },
    "suggest": {
        "bakame/tokei": "Local times, durations and circular time intervals",
        "brick/date-time": "First-class local dates, times and date-time value objects",
        "ext-intl": "Better slug transliteration in Kaly\\Util\\Str::slug",
        "latte/latte": "Recommended template language, through Kaly\\View\\Adapter\\LatteRenderer",
        "lekoala/kaly-forms": "Server-rendered HTML forms with progressive enhancement, through the kaly-forms recipe",
        "lekoala/kaly-tpl": "Lightweight native PHP templates, through Kaly\\View\\Adapter\\KalyTplRenderer",
        "nyholm/psr7": "Recommended PSR-7 implementation for your application",
        "nesbot/carbon": "Rich DateTime-compatible date and time manipulation",
        "spomky-labs/otphp": "TOTP/HOTP second-factor authentication",
        "symfony/mailer": "Email delivery through SMTP, sendmail or supported providers",
        "symfony/translation": "Full featured translations (ICU, loaders), through Kaly\\I18n\\Adapter\\SymfonyTranslator",
        "twig/twig": "Supported template engine, through Kaly\\View\\Adapter\\TwigRenderer",
        "web-auth/webauthn-lib": "WebAuthn/FIDO2 strong authentication and passkeys"
    },
    "autoload": {
        "psr-4": {
            "Kaly\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kaly\\Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "@phpunit",
            "@phpstan",
            "@mago:lint",
            "@mago:guard",
            "@format:check"
        ],
        "phpunit": "@php -d zend.assertions=1 vendor/bin/phpunit",
        "phpunit:only": "@php -d zend.assertions=1 vendor/bin/phpunit --group only",
        "phpunit:coverage": "@php -d zend.assertions=1 vendor/bin/phpunit --coverage-text --coverage-clover=coverage.xml",
        "phpstan": [
            "@phpstan:src",
            "@phpstan:tests"
        ],
        "phpstan:src": "phpstan analyse src --memory-limit=-1",
        "phpstan:tests": "phpstan analyse tests demos -c phpstan-tests.neon --memory-limit=-1",
        "mago:lint": "mago lint --minimum-report-level warning src tests demos",
        "mago:guard": "mago guard --minimum-report-level error",
        "mago:format": "mago fmt",
        "format:check": "mago fmt --check",
        "fmt": "@mago:format",
        "bench": "@php benchmarks/boot.php",
        "docs": [
            "Composer\\Config::disableProcessTimeout",
            "bundle exec --gemfile=docs/Gemfile jekyll serve --source docs --livereload"
        ],
        "demos": [
            "Composer\\Config::disableProcessTimeout",
            "php -S 127.0.0.1:8080 -t demos/"
        ],
        "demo:app": [
            "Composer\\Config::disableProcessTimeout",
            "php -S 127.0.0.1:8080 demos/app/public/index.php"
        ]
    },
    "prefer-stable": true
}
