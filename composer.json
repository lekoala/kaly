{
    "name": "lekoala/kaly",
    "description": "A small modular PSR HTTP framework with convention-based routing and first-class dependency injection",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Thomas",
            "email": "thomas@lekoala.be"
        }
    ],
    "keywords": [
        "framework",
        "http",
        "middleware",
        "psr-7",
        "psr-11",
        "psr-15",
        "router"
    ],
    "require": {
        "php": "^8.3",
        "lekoala/kaly-di": "^0.1",
        "laminas/laminas-escaper": "^2.13",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "psr/clock": "^1.0",
        "psr/container": "^1.1.2|^2.0.2",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "psr/simple-cache": "^3.0",
        "symfony/polyfill-php84": "^1.30"
    },
    "require-dev": {
        "carthage-software/mago": "^1",
        "composer/ca-bundle": "^1.5",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12",
        "symfony/var-dumper": "^7.1"
    },
    "autoload": {
        "psr-4": {
            "Kaly\\": "src"
        },
        "files": [
            "src/_functions/global.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Kaly\\Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "@phpunit",
            "@phpstan",
            "@mago:lint",
            "@mago:format"
        ],
        "phpunit": "@php -d zend.assertions=1 vendor/bin/phpunit",
        "phpunit-only": "@php -d zend.assertions=1 vendor/bin/phpunit --group only",
        "phpstan": "phpstan analyse src --memory-limit=-1",
        "mago:lint": "mago lint --minimum-report-level warning src tests",
        "mago:format": "mago fmt --check",
        "fmt": "mago fmt",
        "docsify": "docsify serve docs",
        "docs": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:3000 -t docs/"
        ],
        "demos": [
            "Composer\\Config::disableProcessTimeout",
            "php -S 127.0.0.1:8080 -t demos/"
        ],
        "demo-app": [
            "Composer\\Config::disableProcessTimeout",
            "php -S 127.0.0.1:8080 demos/app/public/index.php"
        ]
    },
    "prefer-stable": true
}
